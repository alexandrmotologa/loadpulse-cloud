# LoadPulse Cloud - Configuration Blueprint

# Telegram Bot API Token obtained from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Server port (default: 8080)
PORT=8080

# Demo mode (true runs synthetic benchmarks without hitting remote servers)
DEMO_MODE=true

# Mini App URL (optional: used by the bot to attach Telegram WebApp buttons)
# In local development, leave empty or point to your ngrok/localtunnel HTTPS URL
WEB_APP_URL=

# Safety limits for on-demand benchmarks
MAX_CONCURRENCY=100
MAX_DURATION_SEC=30
DEFAULT_TIMEOUT_MS=10000
DATA_DIR=./data
